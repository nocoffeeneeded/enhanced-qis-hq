{
  "manifest_version": 3,
  "name": "Enhanced QIS",
  "version": "1.1.0",
  "description": "Enhancements for the QIS grades portal of Hochschule Trier.",
  "icons": {
    "32": "icons/32x.png",
    "48": "icons/64x.png",
    "128": "icons/128x.png"
  },
  "content_scripts": [
    {
      "matches": ["*://qis.hochschule-trier.de/*"],
      "js": ["index.js"]
    }
  ]
}
